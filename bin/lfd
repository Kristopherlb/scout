#!/usr/bin/env bash
# lfd — the one door into the eval hub.
set -euo pipefail

HUB_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CMD="${1:-help}"
shift || true

case "$CMD" in
  status)      exec python3 "$HUB_ROOT/tools/lfd_status.py" --hub-root "$HUB_ROOT" "$@" ;;
  dashboard)   exec python3 "$HUB_ROOT/tools/lfd_dashboard.py" --hub-root "$HUB_ROOT" "$@" ;;
  doctor)      exec python3 "$HUB_ROOT/tools/lfd_doctor.py" --hub-root "$HUB_ROOT" "$@" ;;
  onboard)     exec python3 "$HUB_ROOT/tools/lfd_onboard.py" --hub-root "$HUB_ROOT" "$@" ;;
  new-target)  exec python3 "$HUB_ROOT/tools/lfd_onboard.py" --hub-root "$HUB_ROOT" start "$@" ;;
  review)      exec python3 "$HUB_ROOT/tools/lfd_review.py" "$@" --hub-root "$HUB_ROOT" ;;
  retro)       exec python3 "$HUB_ROOT/tools/lfd_retro.py" "$@" --hub-root "$HUB_ROOT" ;;
  poll)        exec bash "$HUB_ROOT/ops/poll-and-score.sh" "$HUB_ROOT/targets/${1:?usage: lfd poll <target>}" ;;
  poll-all)
    for t in "$HUB_ROOT"/targets/*/; do
      [ -f "$t/target.json" ] && bash "$HUB_ROOT/ops/poll-and-score.sh" "$t"
    done ;;
  audit)      exec python3 "$HUB_ROOT/tools/lfd_audit.py" "$@" --hub-root "$HUB_ROOT" ;;
  canaries)    exec bash "$HUB_ROOT/ops/generate-canaries.sh" "$HUB_ROOT/targets/${1:?usage: lfd canaries <target>}" ;;
  test)        exec python3 -m unittest discover -s "$HUB_ROOT/tools/tests" -v ;;
  help)
    cat <<'EOF'
lfd — LFD eval hub

  lfd status [-v] [--target NAME]   per-target health: scores ± CI, sparkline,
                                    divergence/liveness/probe flags, economics
  lfd dashboard                     regenerate dashboard/index.html (self-contained)
  lfd doctor [--target NAME]         validate local tools, contract, and sandbox
  lfd onboard <verb> ...             start, inspect, equip, verify, status, or run
  lfd new-target <name> <repo-url>  compatibility alias for `onboard start`
  lfd poll <target> | poll-all      run the scoring poll locally
  lfd audit <target>                Phase 8.5 mechanical audit for a target
  lfd canaries <target>             embed fresh canaries in a target's holdout
  lfd review <target> [--k N]       human spot-check: random holdout cases,
                                    expected vs candidate output (hub-side only)
  lfd retro <target>                scaffold a post-run retrospective
  lfd test                          run the hub's unit tests

Docs: README.md · docs/onboarding-a-target.md · docs/architecture.md · SECURITY.md
EOF
    ;;
  *)
    echo "lfd: unknown command: $CMD" >&2
    echo "Run 'lfd help' for usage." >&2
    exit 2 ;;
esac
